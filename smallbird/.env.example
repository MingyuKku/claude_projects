# 복사해서 .env.local 로 쓴다. 실제 값은 커밋하지 않는다 (.gitignore).
# VITE_ 로 시작하는 값은 브라우저 번들에 들어간다. 런타임 환경 변수를 추가하면 src/shared/config/env.d.ts와 env.ts에도 반영한다.

# --- 백엔드 주소 ---------------------------------------------------------------
# 배포 환경(CI STAGE_ENV_FILE)은 백엔드 절대 주소를 넣는다. 백엔드가 배포 도메인을 CORS 허용한다.
# 로컬 개발은 경로 접두사를 넣고 아래 VITE_PROXY_*_URL로 개발 서버 프록시(vite server.proxy)를 거친다.
VITE_API_SERVER_URL=
VITE_API_MEMBER_URL=
VITE_API_AUTH_URL=
# 결제 서버(bigbird-pay-be)
VITE_API_PAY_URL=

# 개발 서버 프록시 대상. 접두사(VITE_API_*_URL)와 대상이 모두 있는 백엔드만 프록시한다(vite.config.ts). 배포 환경에는 넣지 않는다.
VITE_PROXY_SERVER_URL=
VITE_PROXY_MEMBER_URL=
VITE_PROXY_AUTH_URL=
VITE_PROXY_PAY_URL=

# --- 결제 ----------------------------------------------------------------------
# KG이니시스 표준결제 스크립트 주소(운영·테스트가 다름)
VITE_INICIS_STDPAY_URL=

# --- 소셜 로그인 -----------------------------------------------------------------
# 공개 클라이언트 식별자. 환경마다 값이 다르다.
VITE_OAUTH_REDIRECT_URL=
VITE_NAVER_CLIENT_ID=
VITE_KAKAO_REST_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# --- 서비스 도메인 ---------------------------------------------------------------
# 이 앱의 대표 도메인(랜딩 페이지 og:url·og:image에 씀)
VITE_DOMAIN=

# --- 고객센터 실시간 상담(Firebase) ------------------------------------------------
# 공개 웹 설정. dev: bb-dev-unity-helpdesk, prod: bb-ops-unity-helpdesk (Firebase 콘솔 > 프로젝트 설정 > 웹 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- 로컬 개발 도구 (번들에 들어가지 않음) -----------------------------------------
# Figma 시안 수집(scripts/design: 구현 시안 요약·디자인 QA). 팀원마다 개인 토큰을 만들어 넣는다.
# 권한은 File content·File versions·Current user Read만. VITE_ 를 붙이지 않는다(붙이면 번들에 들어감).
# 만드는 방법: .claude/skills/design-qa/references/workflow.md "Figma 토큰 준비"
FIGMA_TOKEN=
