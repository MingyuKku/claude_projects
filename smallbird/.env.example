# 복사해서 .env.local 로 쓴다. 실제 값은 커밋하지 않는다 (.gitignore).
# 런타임 환경 변수를 추가하면 src/shared/config/env.d.ts와 env.ts에도 반영한다.


# --- Auth backends (migrated from bigbird-client-fe) ------------------------
# Declared in src/shared/config/env.d.ts and read through src/shared/config/env.ts.
# Values are path prefixes, not absolute URLs: the backends' CORS allowlists do not
# include this app's origin, so the dev proxy (vite server.proxy) and the production
# reverse proxy forward each prefix to its backend.
VITE_API_SERVER_URL=
VITE_API_MEMBER_URL=
VITE_API_SOCIAL_URL=
VITE_API_AUTH_URL=

# 개발 서버 프록시 대상. prefix와 target이 모두 설정된 백엔드만 프록시한다.
VITE_PROXY_SERVER_URL=
VITE_PROXY_MEMBER_URL=
VITE_PROXY_SOCIAL_URL=
VITE_PROXY_AUTH_URL=

# Social login. Public client identifiers; values differ per environment.
VITE_OAUTH_REDIRECT_URL=
VITE_NAVER_CLIENT_ID=
VITE_KAKAO_APP_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URL=

# Canonical domain of this app (used by the landing page's og:url / og:image).
VITE_DOMAIN=

# Helpdesk Firebase (customer-center real-time consultation). Public web config.
# dev: bb-dev-unity-helpdesk, prod: bb-ops-unity-helpdesk (Firebase console > Project settings > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
