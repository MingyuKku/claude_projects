# 빌드된 SPA 정적 파일을 서빙한다. API 는 브라우저가 백엔드로 직접 요청한다(백엔드가 이 앱 origin 을 CORS 허용).
# 예외로 이니시스 결과 수신 주소만 결제 서버로 넘긴다(아래 location).
# nginx 이미지가 컨테이너 시작 때 이 템플릿의 ${PAY_UPSTREAM} 을 환경 값으로 바꿔 conf.d/default.conf 로 만든다.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vite 가 파일 이름에 해시를 붙이므로 오래 캐시한다.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 배포 직후 새 번들을 받도록 진입 HTML 은 매번 확인한다.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 이니시스는 returnUrl 의 도메인이 결제를 요청한 페이지와 같아야 해서(V023) 결과를 이 앱 도메인으로 받아 결제 서버로 넘긴다.
    # 결제 서버 IP 가 고정이 아니어서 변수로 넘겨 요청 때마다 Docker 내장 DNS 로 다시 조회한다.
    location = /v3/mypage/bigbird-money/pay/result {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $pay_upstream ${PAY_UPSTREAM};
        proxy_pass $pay_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    }

    # SPA: 파일이 없는 경로는 index.html 로 넘겨 클라이언트 라우터가 처리한다.
    location / {
        try_files $uri /index.html;
    }
}
