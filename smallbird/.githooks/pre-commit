#!/bin/sh
# 커밋 전 스테이징된 파일을 Prettier · ESLint 로 검사한다. (도구와 무관하게 적용되는 사람용 게이트)
# - 고치지 않고 검사만 한다. 자동 교정은 `pnpm lint --fix`, `pnpm format`.
# - 검사 대상 제외는 .prettierignore 와 eslint.config.js 의 ignores 가 정한다. CI(format:check, lint)와 같은 범위다.
# - 스테이징된 내용이 아니라 작업 트리의 파일을 검사한다. 일부만 add 하면 실제 커밋 내용과 다를 수 있다.
# - 최종 판정은 CI 가 한다. 급할 때의 우회(--no-verify)는 CI 에서 걸린다.
# - 활성화: `pnpm install` 의 prepare 스크립트가 core.hooksPath 를 설정한다.

ESLINT="node_modules/.bin/eslint"
PRETTIER="node_modules/.bin/prettier"

if [ ! -x "$ESLINT" ] || [ ! -x "$PRETTIER" ]; then
  echo "pre-commit: node_modules 가 없어 검사를 건너뜁니다. pnpm install 을 먼저 실행하세요." >&2
  exit 0
fi

# 경로는 NUL 로 구분해 넘긴다. 공백·한글 파일명이 쪼개지거나 이스케이프되지 않게 하기 위해서다.
staged() { git diff --cached -z --name-only --diff-filter=ACM -- "$@"; }

# Prettier 가 모르는 형식(이미지 등)은 --ignore-unknown 으로 건너뛴다.
if [ -n "$(staged | tr -d '\0')" ]; then
  staged | xargs -0 "$PRETTIER" --check --ignore-unknown || {
    echo "pre-commit: 포맷이 맞지 않습니다. pnpm format 후 다시 add 하세요." >&2
    exit 1
  }
fi

# 경고(max-lines 크기 신호)는 커밋을 막지 않는다. error 만 막는 기준은 CI 의 pnpm lint 와 같다.
# --no-warn-ignored: 생성물 등 ignores 대상 파일을 넘겨도 경고하지 않는다.
lintable() { staged '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs'; }
if [ -n "$(lintable | tr -d '\0')" ]; then
  lintable | xargs -0 "$ESLINT" --no-warn-ignored || {
    echo "pre-commit: ESLint 오류가 있습니다. 억제하지 말고 원인을 고치세요." >&2
    exit 1
  }
fi
